# GitHub Storage Persistence (Zero Database)
# Generate a Personal Access Token on GitHub with 'repo' or Contents (Read & Write) permissions
GITHUB_TOKEN=
GITHUB_TOKENS=
GITHUB_REPO=chika-obi/JTEX-SERVICES
GITHUB_BRANCH=main

# Optional: Custom security salt for 4-digit PIN hashing
PIN_SALT=

# Optional: Static environment overrides for PINs (defaults to 1965)
ADMIN_PIN=
RECEIPT_PIN=
